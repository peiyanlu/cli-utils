{
  "name": "@peiyanlu/cli-utils",
  "version": "0.0.14",
  "description": "Shared utils for building interactive Node.js CLI applications.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "prepublishOnly": "tsdown",
    "release": "release",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@peiyanlu/ts-utils": "latest",
    "ansis": "^4.3.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@peiyanlu/release": "^1.2.0",
    "@peiyanlu/test-tools": "^0.0.7",
    "@types/node": "^24.13.3",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.10",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "author": {
    "name": "YanluPei",
    "email": "peiyanlu@vip.qq.com"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "typescript",
    "lib"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peiyanlu/cli-utils.git"
  },
  "bugs": {
    "url": "https://github.com/peiyanlu/cli-utils/issues"
  },
  "homepage": "https://github.com/peiyanlu/cli-utils#readme"
}
