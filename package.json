{
  "name": "@peiyanlu/cli-utils",
  "version": "0.0.7",
  "description": "Shared utils for building interactive Node.js CLI applications.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "prepublish": "tsdown",
    "release": "release",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@peiyanlu/release": "^0.0.7",
    "@types/node": "^24.10.3",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.0.15",
    "tsdown": "^0.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "author": {
    "name": "YanluPei",
    "email": "peiyanlu@vip.qq.com"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "typescript",
    "lib"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peiyanlu/cli-utils.git"
  },
  "bugs": {
    "url": "https://github.com/peiyanlu/cli-utils/issues"
  },
  "homepage": "https://github.com/peiyanlu/cli-utils#readme",
  "dependencies": {
    "semver": "^7.7.3"
  }
}
